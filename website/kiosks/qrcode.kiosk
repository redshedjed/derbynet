<!DOCTYPE html>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
<title>QRCode</title>
<script type="text/javascript" src="js/jquery.js"></script>
<script type="text/javascript" src="js/jquery-migrate.js"></script>
<script type="text/javascript" src="js/qrcode.min.js"></script>
<?php require('inc/kiosk-poller.inc'); ?>
<?php require('inc/stylesheet.inc'); ?>
<link rel="stylesheet" type="text/css" href="css/kiosks.css"/>
<style type="text/css">
body { overflow: hidden; }
h2 {
  text-align: center;
  font-size: var(--kiosk-text-lg);
  margin: var(--space-3) 0 0 0;
}
/* The code: a square that fits under the title, centered (its size is set
   below, from the window) */
#qrcode {
  margin: var(--space-4) auto 0 auto;
}
#qrcode img, #qrcode canvas {
  display: block;
}
</style>
<script type="text/javascript">

$(function() {
    var dim = Math.round(Math.min(.8 * $(window).width(),
                                  window.innerHeight - 250));
    $("#qrcode").css('width', dim + 'px');

    var qrcode = null;
    var title = '';
    var content = '';

    KioskPoller.param_callback = function(parameters) {
      console.log(parameters);
      if (parameters.hasOwnProperty('title') && parameters.title != title) {
        console.log('Changing title');
        $("#qrcode-title").text(title = parameters.title);
      }
      if (parameters.hasOwnProperty('content') && parameters.content != content) {
        console.log('Changing content');
        if (!qrcode) {
          console.log('dim', dim, 'content', parameters.content);
          qrcode = new QRCode(document.getElementById("qrcode"),
                              {text: content = parameters.content,
                                width: dim,
                                height: dim,
                                });
        }

        qrcode.clear();
        qrcode.makeCode(content = parameters.content);
      }
    };
  });
</script>
</head>
<body>
<?php
require_once('inc/banner.inc');
make_banner('', /* back_button */ false);
?>

<h2 id="qrcode-title"></h2>

 <div id="qrcode">&nbsp;</div>

