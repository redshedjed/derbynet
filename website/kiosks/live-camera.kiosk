<?php
// Live Camera: one track camera's picture, live, filling the screen.
// Parameters: {camera: (name)}; with no camera chosen, the first track camera
// that's switched on (Settings > Cameras).  On a kiosk whose location shows
// replays, the replay slides in over this at the end of each heat.
require_once('inc/replay.inc');
$params = kiosk_parameters();
$camera = isset($params['camera']) ? $params['camera'] : '';
if ($camera === '') {
  $cameras = track_cameras(/* enabled_only */ true);
  if (count($cameras) > 0) {
    $camera = $cameras[0]['name'];
  }
}
?><!DOCTYPE html>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
<title>Live Camera</title>
<link rel="stylesheet" type="text/css" href="css/global.css"/>
<link rel="stylesheet" type="text/css" href="css/kiosks.css"/>
<style type="text/css">
html, body {
  margin: 0;
  height: 100%;
  overflow: hidden;
  background: black;
}
#live {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  object-fit: contain;
}
#live-label {
  position: fixed;
  left: 2vh;
  bottom: 2vh;
  padding: 0.3em 0.7em;
  border-radius: 6px;
  background: rgba(0, 0, 0, 0.55);
  color: white;
  font-size: var(--kiosk-text-sm);
  font-weight: 600;
}
#live-label .dot {
  display: inline-block;
  width: 0.6em;
  height: 0.6em;
  margin-right: 0.4em;
  border-radius: 50%;
  background: #E0302E;
}
#live-waiting {
  position: fixed;
  top: 45%;
  width: 100%;
  text-align: center;
  color: #ccc;
  font-size: var(--kiosk-text-base);
}
</style>
<script type="text/javascript" src="js/jquery.js"></script>
<script type="text/javascript" src="js/jquery-migrate.js"></script>
<?php require('inc/kiosk-poller.inc'); ?>
<script type="text/javascript" src="js/message-poller.js"></script>
<script type="text/javascript" src="js/viewer-signaling.js"></script>
<script type="text/javascript">
var g_websocket_url = <?php echo json_encode(read_raceinfo('_websocket_url', '')); ?>;
var g_camera_name = <?php echo json_encode($camera); ?>;
var g_chosen_camera = <?php echo json_encode(isset($params['camera']) ? $params['camera'] : ''); ?>;

$(function() {
  if (g_camera_name === '') {
    $("#live-waiting").text('No track camera is switched on (Settings > Cameras).');
    $("#live-label").addClass('hidden');
  } else {
    $("#live-camera-name").text(g_camera_name);
    new RemoteCamera(make_id_string('live-'),
                     {width: $(window).width(), height: $(window).height()},
                     function(stream) {
                       document.getElementById('live').srcObject = stream;
                       $("#live-waiting").addClass('hidden');
                     },
                     g_camera_name);
  }
  // A different camera chosen on the Kiosk Dashboard: start over with it.
  KioskPoller.param_callback = function(parameters) {
    if ((parameters.camera || '') != g_chosen_camera) {
      location.reload();
    }
  };
});
</script>
</head>
<body>
<video id="live" autoplay="autoplay" muted="muted" playsinline="playsinline"></video>
<div id="live-waiting">Waiting for the <?php echo htmlspecialchars($camera, ENT_QUOTES, 'UTF-8'); ?> camera...</div>
<div id="live-label"><span class="dot"></span><span id="live-camera-name"></span></div>
<?php require('inc/ajax-failure.inc'); ?>
</body>
</html>
